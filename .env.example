APP_NAME=MondoDiVino
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# HVCO USA funnel
HVCO_LANDING_VARIANT=main
HVCO_COLLECT_ZIP=false
HVCO_CONSENT_TEXT="Free instant access. We'll also send occasional Italian wine insights and offers. Unsubscribe anytime."
# Optional absolute/public URL for the approved guide mockup image.
HVCO_GUIDE_MOCKUP=
HVCO_TASTE_PROFILE_LINK_DAYS=30
HVCO_PROFILE_CONSENT_TEXT="I agree that MondoDiVino may use these answers to prepare my consultation and contact me about it. I have read the Privacy Policy."
HVCO_SMS_CONSENT_TEXT="I agree to receive optional text messages from MondoDiVino. Message and data rates may apply. Reply STOP to opt out."
# Leave empty until the approved shipping/serviceability list is available.
HVCO_SERVICEABLE_STATES=
# Optional option key, e.g. 500_749. Empty means no budget qualification threshold.
HVCO_MINIMUM_SET_BUDGET=

# Brevo (never commit real values)
BREVO_API_KEY=
BREVO_LIST_ID=
BREVO_HVCO_TEMPLATE_ID=
BREVO_HVCO_GUIDE_URL=
BREVO_WEBHOOK_SECRET=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME="MondoDiVino"

# Cal.com booking (never commit real secrets)
# Full public event URL, e.g. https://cal.com/username/private-session.
CALCOM_EMBED_URL=
CALCOM_EVENT_TYPE_ID=
CALCOM_EVENT_TYPE_SLUG=
CALCOM_USERNAME=
CALCOM_TEAM_SLUG=
CALCOM_WEBHOOK_SECRET=
CALCOM_API_VERSION=2021-10-20
CALCOM_SUPPORT_EMAIL=
# Display-only until the approved duration is supplied, e.g. 30 minutes.
CALCOM_BOOKING_DURATION=

# Meta Pixel + Conversions API (never commit real values)
# Current Graph API version as of 2026-08-23.
META_PIXEL_ID=
META_CONVERSIONS_API_TOKEN=
META_GRAPH_API_VERSION=v26.0
META_GRAPH_BASE_URL=https://graph.facebook.com
# Populate only while validating events in Meta Events Manager, then clear it.
META_TEST_EVENT_CODE=
# Public page explaining Meta Business Tools usage and privacy choices.
META_PRIVACY_POLICY_URL=
META_CONSENT_COOKIE=mdv_meta_consent
META_CONSENT_LIFETIME_DAYS=180
# Optional Limited Data Use configuration, for example: LDU
META_DATA_PROCESSING_OPTIONS=
META_DATA_PROCESSING_OPTIONS_COUNTRY=0
META_DATA_PROCESSING_OPTIONS_STATE=0
